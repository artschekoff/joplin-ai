# Snyk (https://snyk.io) policy file
# Ignores known upstream vulnerabilities in @joplin/utils transitive deps.
# Review and remove entries once upstream publishes a fix.
version: v1.25.0
ignore:
  SNYK-JS-GLOB-14040952:
    - '@joplin/utils > glob':
        reason: >-
          Transitive dep of @joplin/utils@3.5.1 — fix requires breaking major
          upgrade. CLI command injection not exploitable in plugin context.
        expires: 2026-10-11T00:00:00.000Z
        created: 2026-04-12T00:00:00.000Z
  SNYK-JS-MARKDOWNIT-10666750:
    - '@joplin/utils > markdown-it':
        reason: >-
          Transitive dep of @joplin/utils@3.5.1 — fix requires breaking major
          upgrade. ReDoS risk is low for trusted note content.
        expires: 2026-10-11T00:00:00.000Z
        created: 2026-04-12T00:00:00.000Z
